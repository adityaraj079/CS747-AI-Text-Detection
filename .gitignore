# Python virtual envs and caches
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter and editor state
.ipynb_checkpoints/
